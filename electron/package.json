{
  "name": "guaitacaptura-electron",
  "version": "0.1.0",
  "private": true,
  "description": "guaitaCaptura — build experimental Electron (CAT: empaquetat de proves)",
  "main": "main.js",
  "author": "Jordi Subirós (SBS BiM Consulting)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "cat.subiros.guaitacaptura",
    "productName": "guaitaCaptura",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "picker.html", "icons/**"],
    "extraResources": [
      { "from": "../pagesCAT", "to": "pagesCAT" },
      { "from": "../pagesENG", "to": "pagesENG" }
    ],
    "mac": { "category": "public.app-category.utilities", "target": ["dmg"] },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"], "category": "Utility" }
  }
}
